// PE-local program for exact distributed Top-K kNN.
//
// Host packing gives every PE a row shard of D, biased row norms
// (||D_i||^2 + ||q||^2), and a valid_count used to mask padding. PE (0,0)
// receives q and broadcasts it across the top row and then down each column.
// Each PE computes exact squared L2 distances for its local rows, keeps K local
// candidates, and sends those pairs through a two-stage reduction:
//   1. gather each row to column 0 and reduce P*K candidates to K
//   2. gather row winners up column 0 and reduce P*K candidates at PE (0,0)
//
// The same total order is used at every stage: smaller distance first, then
// smaller original row index. Padding rows are represented by sentinel pairs.

param memcpy_params;
param c2d_params;
param P: u16;
param d_dim: u16;
param rows_per_pe: u16;
param K: u16;
param D_block: u16;

const bcast_q_down_task_id: local_task_id = @get_local_task_id(6);
const compute_task_id:      local_task_id = @get_local_task_id(7);
const gather_row_i_task_id: local_task_id = @get_local_task_id(8);
const gather_col_d_task_id: local_task_id = @get_local_task_id(9);
const gather_col_i_task_id: local_task_id = @get_local_task_id(14);
const finish_task_id:       local_task_id = @get_local_task_id(18);

const sys_mod = @import_module("<memcpy/memcpy>", memcpy_params);
const mpi_x = @import_module("<collectives_2d/pe>", .{ .dim_params = c2d_params.x });
const mpi_y = @import_module("<collectives_2d/pe>", .{ .dim_params = c2d_params.y });

const D_LEN: u16 = rows_per_pe * d_dim;
const rows_per_pe_i16: i16 = @as(i16, rows_per_pe);
const d_dim_i16: i16 = @as(i16, d_dim);
const D_BLOCK: u16 = D_block;
const D_BLOCK_I16: i16 = @as(i16, D_BLOCK);
const USE_BLOCKED_D_LAYOUT: bool = true;
const BASELINE_K: u16 = 16;
const SORT_STREAMS_WHEN_FULL_K: bool = true;
const INF: f32 = 1.0e30;
const SENTINEL_INDEX: u32 = 2147483647;

var D = @zeros([D_LEN]f32);
var D_norms = @zeros([rows_per_pe]f32);
var q = @zeros([d_dim]f32);
var scaled_q = @zeros([d_dim]f32);
var valid_count = @zeros([1]u32);
var distance_scratch = @zeros([rows_per_pe]f32);
var local_distances = @zeros([K]f32);
var local_indices = @zeros([K]u32);
var row_distances = @zeros([P * K]f32);
var row_indices = @zeros([P * K]u32);
var row_top_distances = @zeros([K]f32);
var row_top_indices = @zeros([K]u32);
var all_distances = @zeros([P * K]f32);
var all_indices = @zeros([P * K]u32);
var heap_distances = @zeros([K]f32);
var heap_indices = @zeros([K]u32);
var heap_size: u16 = 0;
var merge_offsets = @zeros([P]u16);
var final_distances = @zeros([K]f32);
var final_indices = @zeros([K]u32);
var ptr_D: [*]f32 = &D;
var ptr_D_norms: [*]f32 = &D_norms;
var ptr_q: [*]f32 = &q;
var ptr_valid_count: [*]u32 = &valid_count;
const ptr_final_distances: [*]f32 = &final_distances;
const ptr_final_indices: [*]u32 = &final_indices;

var D_col_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{rows_per_pe_i16} -> D[i * d_dim_i16] });
var D_block_col_dsd = @get_dsd(mem1d_dsd, .{ .tensor_access = |i|{rows_per_pe_i16} -> D[i * D_BLOCK_I16] });
var norms_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &D_norms, .extent = rows_per_pe });
var dist_dsd = @get_dsd(mem1d_dsd, .{ .base_address = &distance_scratch, .extent = rows_per_pe });

var px: u16;
var py: u16;

// Total-order helpers for deterministic top-K selection and heap maintenance.
fn better(distance: f32, index: u32, other_distance: f32, other_index: u32) bool {
  if (distance < other_distance) {
    return true;
  }
  if ((distance == other_distance) and (index < other_index)) {
    return true;
  }
  return false;
}

fn worse(distance: f32, index: u32, other_distance: f32, other_index: u32) bool {
  if (distance > other_distance) {
    return true;
  }
  if ((distance == other_distance) and (index > other_index)) {
    return true;
  }
  return false;
}

fn init_local_topk() void {
  for (@range(u16, K)) |i| {
    local_distances[i] = INF;
    local_indices[i] = SENTINEL_INDEX;
  }
}

fn insert_local(distance: f32, index: u32) void {
  var pos: i16 = @as(i16, K) - 1;
  if (!better(distance, index, local_distances[pos], local_indices[pos])) {
    return;
  }

  while (pos > 0) : (pos -= 1) {
    const prev = pos - 1;
    if (!better(distance, index, local_distances[prev], local_indices[prev])) {
      break;
    }
    local_distances[pos] = local_distances[prev];
    local_indices[pos] = local_indices[prev];
  }

  local_distances[pos] = distance;
  local_indices[pos] = index;
}

fn heap_swap(a: u16, b: u16) void {
  const tmp_dist = heap_distances[a];
  const tmp_idx = heap_indices[a];
  heap_distances[a] = heap_distances[b];
  heap_indices[a] = heap_indices[b];
  heap_distances[b] = tmp_dist;
  heap_indices[b] = tmp_idx;
}

fn heap_sift_up(start: u16) void {
  var child = start;
  while (child > 0) {
    const parent = (child - 1) / 2;
    if (!worse(heap_distances[child], heap_indices[child],
               heap_distances[parent], heap_indices[parent])) {
      break;
    }
    heap_swap(child, parent);
    child = parent;
  }
}

fn heap_sift_down(start: u16) void {
  var parent = start;
  while (true) {
    const left = parent * 2 + 1;
    const right = left + 1;
    var worst = parent;

    if ((left < heap_size) and
        worse(heap_distances[left], heap_indices[left],
              heap_distances[worst], heap_indices[worst])) {
      worst = left;
    }
    if ((right < heap_size) and
        worse(heap_distances[right], heap_indices[right],
              heap_distances[worst], heap_indices[worst])) {
      worst = right;
    }
    if (worst == parent) {
      break;
    }
    heap_swap(parent, worst);
    parent = worst;
  }
}

fn heap_reset() void {
  // heap_consider overwrites every occupied slot before the sorted drain reads
  // it, so resetting the size is enough for a fresh heap.
  heap_size = 0;
}

fn heap_consider(distance: f32, index: u32) void {
  if (heap_size < K) {
    heap_distances[heap_size] = distance;
    heap_indices[heap_size] = index;
    heap_sift_up(heap_size);
    heap_size += 1;
  } else {
    if (better(distance, index, heap_distances[0], heap_indices[0])) {
      heap_distances[0] = distance;
      heap_indices[0] = index;
      heap_sift_down(0);
    }
  }
}

fn heap_pop_worst_into(out_distances: [*]f32, out_indices: [*]u32, out_idx: u16) void {
  // The max-heap root is the worst pair among the current K best. Popping into
  // the output from the end yields ascending final order in O(K log K).
  out_distances[out_idx] = heap_distances[0];
  out_indices[out_idx] = heap_indices[0];

  heap_size -= 1;
  if (heap_size > 0) {
    heap_distances[0] = heap_distances[heap_size];
    heap_indices[0] = heap_indices[heap_size];
    heap_sift_down(0);
  }
}

fn write_heap_sorted(out_distances: [*]f32, out_indices: [*]u32) void {
  for (@range(u16, K)) |i| {
    const out_idx = (K - 1) - i;
    heap_pop_worst_into(out_distances, out_indices, out_idx);
  }
}

fn merge_sorted_streams(
    src_distances: [*]f32, src_indices: [*]u32,
    out_distances: [*]f32, out_indices: [*]u32) void {
  // Small-K candidates arrive as P sorted K-lists. Merge by advancing one
  // cursor per source stream instead of repeatedly rescanning the whole buffer.
  if ((P == 4) and (K == BASELINE_K)) {
    // Baseline-specialized 4-way merge with explicit heads to avoid stream loop
    // control overhead in the hottest reduction path.
    var o0: u16 = 0;
    var o1: u16 = 0;
    var o2: u16 = 0;
    var o3: u16 = 0;
    for (@range(u16, BASELINE_K)) |out_idx| {
      var best_stream: u16 = 0;
      var best_distance: f32 = INF;
      var best_index: u32 = SENTINEL_INDEX;

      if (o0 < BASELINE_K) {
        best_stream = 0;
        best_distance = src_distances[o0];
        best_index = src_indices[o0];
      }
      if (o1 < BASELINE_K) {
        const p1 = BASELINE_K + o1;
        if (better(src_distances[p1], src_indices[p1], best_distance, best_index)) {
          best_stream = 1;
          best_distance = src_distances[p1];
          best_index = src_indices[p1];
        }
      }
      if (o2 < BASELINE_K) {
        const p2 = 2 * BASELINE_K + o2;
        if (better(src_distances[p2], src_indices[p2], best_distance, best_index)) {
          best_stream = 2;
          best_distance = src_distances[p2];
          best_index = src_indices[p2];
        }
      }
      if (o3 < BASELINE_K) {
        const p3 = 3 * BASELINE_K + o3;
        if (better(src_distances[p3], src_indices[p3], best_distance, best_index)) {
          best_stream = 3;
          best_distance = src_distances[p3];
          best_index = src_indices[p3];
        }
      }

      out_distances[out_idx] = best_distance;
      out_indices[out_idx] = best_index;

      if (best_stream == 0) {
        o0 += 1;
      } else if (best_stream == 1) {
        o1 += 1;
      } else if (best_stream == 2) {
        o2 += 1;
      } else {
        o3 += 1;
      }
    }
    return;
  }

  if (P == 2) {
    // Hot path specialization: avoid generic per-output stream scan when the
    // merge fan-in is exactly two sorted streams.
    var offset0: u16 = 0;
    var offset1: u16 = 0;
    for (@range(u16, K)) |out_idx| {
      const has0 = offset0 < K;
      const has1 = offset1 < K;

      if (has0 and
          (!has1 or better(src_distances[offset0], src_indices[offset0],
                           src_distances[K + offset1], src_indices[K + offset1]))) {
        out_distances[out_idx] = src_distances[offset0];
        out_indices[out_idx] = src_indices[offset0];
        offset0 += 1;
      } else {
        out_distances[out_idx] = src_distances[K + offset1];
        out_indices[out_idx] = src_indices[K + offset1];
        offset1 += 1;
      }
    }
    return;
  }

  for (@range(u16, P)) |stream| {
    merge_offsets[stream] = 0;
  }

  for (@range(u16, K)) |out_idx| {
    var best_stream: u16 = 0;
    var best_distance: f32 = INF;
    var best_index: u32 = SENTINEL_INDEX;

    for (@range(u16, P)) |stream| {
      const offset = merge_offsets[stream];
      if (offset < K) {
        const candidate_pos = stream * K + offset;
        if (better(src_distances[candidate_pos], src_indices[candidate_pos],
                   best_distance, best_index)) {
          best_stream = stream;
          best_distance = src_distances[candidate_pos];
          best_index = src_indices[candidate_pos];
        }
      }
    }

    out_distances[out_idx] = best_distance;
    out_indices[out_idx] = best_index;
    merge_offsets[best_stream] += 1;
  }
}

fn merge_buffer_with_heap(src_distances: [*]f32, src_indices: [*]u32,
                          out_distances: [*]f32, out_indices: [*]u32) void {
  heap_reset();
  for (@range(u16, P * K)) |i| {
    heap_consider(src_distances[i], src_indices[i]);
  }
  write_heap_sorted(out_distances, out_indices);
}

fn prepare_scaled_q() void {
  for (@range(u16, d_dim)) |j| {
    scaled_q[j] = -2.0 * q[j];
  }
}

fn insert_local_k16(distance: f32, index: u32) void {
  var pos: i16 = 15;
  if (!better(distance, index, local_distances[pos], local_indices[pos])) {
    return;
  }

  while (pos > 0) : (pos -= 1) {
    const prev = pos - 1;
    if (!better(distance, index, local_distances[prev], local_indices[prev])) {
      break;
    }
    local_distances[pos] = local_distances[prev];
    local_indices[pos] = local_indices[prev];
  }

  local_distances[pos] = distance;
  local_indices[pos] = index;
}

fn seed_sort_local_k16() void {
  for (@range(u16, 15)) |i| {
    const start = i + 1;
    const key_distance = local_distances[start];
    const key_index = local_indices[start];
    var pos: i16 = @as(i16, i);
    while (pos >= 0) : (pos -= 1) {
      if (!better(key_distance, key_index,
                  local_distances[@as(u16, pos)], local_indices[@as(u16, pos)])) {
        break;
      }
      local_distances[@as(u16, pos + 1)] = local_distances[@as(u16, pos)];
      local_indices[@as(u16, pos + 1)] = local_indices[@as(u16, pos)];
    }
    local_distances[@as(u16, pos + 1)] = key_distance;
    local_indices[@as(u16, pos + 1)] = key_index;
  }
}

fn compute_local_topk_k16(global_base: u32) void {
  var valid_rows: u16 = rows_per_pe;
  if (valid_count[0] < @as(u32, rows_per_pe)) {
    valid_rows = @as(u16, valid_count[0]);
  }

  var seeded: u16 = BASELINE_K;
  if (valid_rows < BASELINE_K) {
    seeded = valid_rows;
  }

  for (@range(u16, BASELINE_K)) |slot| {
    if (slot < seeded) {
      local_distances[slot] = distance_scratch[slot];
      local_indices[slot] = global_base + @as(u32, slot);
    } else {
      local_distances[slot] = INF;
      local_indices[slot] = SENTINEL_INDEX;
    }
  }

  if (seeded > 1) {
    seed_sort_local_k16();
  }

  for (@range(u16, rows_per_pe)) |row| {
    if ((row >= seeded) and (row < valid_rows)) {
      insert_local_k16(distance_scratch[row], global_base + @as(u32, row));
    }
  }
}

fn compute_all_distances() void {
  // D_norms already includes ||q||^2:
  // distance_scratch[row] = D_norms[row] - 2 * dot(D_row, q).
  // Fuse initialization with the first FMAC to remove one full vector sweep.
  if (d_dim == 0) {
    @fadds(dist_dsd, norms_dsd, 0.0);
    return;
  }

  if (USE_BLOCKED_D_LAYOUT and ((d_dim % D_BLOCK) == 0)) {
    // Blocked host packing stores D as [feature_block][row][intra_block_feature].
    // This keeps per-column row strides at D_BLOCK instead of d_dim.
    const blocks = d_dim / D_BLOCK;
    var j: u16 = 0;
    for (@range(u16, blocks)) |block| {
      var col_dsd = @increment_dsd_offset(
          D_block_col_dsd,
          @as(i16, block * rows_per_pe * D_BLOCK),
          f32);
      for (@range(u16, D_BLOCK)) |intra| {
        if ((block == 0) and (intra == 0)) {
          @fmacs(dist_dsd, norms_dsd, col_dsd, scaled_q[j]);
        } else {
          @fmacs(dist_dsd, dist_dsd, col_dsd, scaled_q[j]);
        }
        col_dsd = @increment_dsd_offset(col_dsd, 1, f32);
        j += 1;
      }
    }
    return;
  }

  // Fallback path for non-block-aligned d_dim.
  @fmacs(dist_dsd, norms_dsd, D_col_dsd, scaled_q[0]);
  var col_dsd = @increment_dsd_offset(D_col_dsd, 1, f32);
  for (@range(u16, d_dim - 1)) |j| {
    @fmacs(dist_dsd, dist_dsd, col_dsd, scaled_q[j + 1]);
    col_dsd = @increment_dsd_offset(col_dsd, 1, f32);
  }
}

fn compute_local_topk() void {
  const pe_linear: u32 = @as(u32, py) * @as(u32, P) + @as(u32, px);
  const global_base: u32 = pe_linear * @as(u32, rows_per_pe);
  compute_all_distances();

  if (K == rows_per_pe) {
    if (SORT_STREAMS_WHEN_FULL_K and (K > BASELINE_K)) {
      // Optional k_large experiment: keep fully sorted local streams so row/final
      // reducers can use the k-way stream merge path.
      heap_reset();
      for (@range(u16, rows_per_pe)) |row| {
        if (@as(u32, row) < valid_count[0]) {
          heap_consider(distance_scratch[row], global_base + @as(u32, row));
        } else {
          heap_consider(INF, SENTINEL_INDEX);
        }
      }
      write_heap_sorted(&local_distances, &local_indices);
    } else {
      // Fast path when every local row is requested.
      for (@range(u16, rows_per_pe)) |row| {
        if (@as(u32, row) < valid_count[0]) {
          local_distances[row] = distance_scratch[row];
          local_indices[row] = global_base + @as(u32, row);
        } else {
          local_distances[row] = INF;
          local_indices[row] = SENTINEL_INDEX;
        }
      }
    }
  } else if (K == 1) {
    var best_distance: f32 = INF;
    var best_index: u32 = SENTINEL_INDEX;

    for (@range(u16, rows_per_pe)) |row| {
      if (@as(u32, row) < valid_count[0]) {
        const distance = distance_scratch[row];
        const global_index = global_base + @as(u32, row);
        if (better(distance, global_index, best_distance, best_index)) {
          best_distance = distance;
          best_index = global_index;
        }
      }
    }

    local_distances[0] = best_distance;
    local_indices[0] = best_index;
  } else if (K == BASELINE_K) {
    compute_local_topk_k16(global_base);
  } else if (K > 16) {
    heap_reset();
    for (@range(u16, rows_per_pe)) |row| {
      if (@as(u32, row) < valid_count[0]) {
        const distance = distance_scratch[row];
        const global_index = global_base + @as(u32, row);
        heap_consider(distance, global_index);
      }
    }
    write_heap_sorted(&local_distances, &local_indices);
  } else {
    init_local_topk();
    for (@range(u16, rows_per_pe)) |row| {
      if (@as(u32, row) < valid_count[0]) {
        const distance = distance_scratch[row];
        const global_index = global_base + @as(u32, row);
        insert_local(distance, global_index);
      }
    }
  }
}

fn merge_global_topk() void {
  // Small cases avoid heap overhead; large K uses a fixed-size max-heap to
  // avoid insertion shifts in the merge buffers.
  if ((K <= BASELINE_K) or (SORT_STREAMS_WHEN_FULL_K and (K == rows_per_pe))) {
    merge_sorted_streams(&all_distances, &all_indices,
                         &final_distances, &final_indices);
  } else {
    merge_buffer_with_heap(&all_distances, &all_indices,
                           &final_distances, &final_indices);
  }
}

fn merge_row_topk() void {
  // Row roots use the same policy as the final root.
  if ((K <= BASELINE_K) or (SORT_STREAMS_WHEN_FULL_K and (K == rows_per_pe))) {
    merge_sorted_streams(&row_distances, &row_indices,
                         &row_top_distances, &row_top_indices);
  } else {
    merge_buffer_with_heap(&row_distances, &row_indices,
                           &row_top_distances, &row_top_indices);
  }
}

fn main() void {
  mpi_x.init();
  mpi_y.init();
  px = mpi_x.pe_id;
  py = mpi_y.pe_id;

  // q starts on PE (0,0). Broadcast across the top row first.
  if (py == 0) {
    mpi_x.broadcast(0, @ptrcast([*]u32, &q), d_dim, bcast_q_down_task_id);
  } else {
    @activate(bcast_q_down_task_id);
  }
}

task bcast_q_down() void {
  // Each top-row PE now has q for its column; broadcast downward.
  mpi_y.broadcast(0, @ptrcast([*]u32, &q), d_dim, compute_task_id);
}

task compute() void {
  prepare_scaled_q();
  compute_local_topk();
  // Gather distances first, then indices, so both arrays use simple contiguous
  // K-element collectives.
  mpi_x.gather(0, @ptrcast([*]u32, &local_distances),
               @ptrcast([*]u32, &row_distances), K, gather_row_i_task_id);
}

task gather_row_indices() void {
  mpi_x.gather(0, @ptrcast([*]u32, &local_indices),
               @ptrcast([*]u32, &row_indices), K, gather_col_d_task_id);
}

task gather_col_distances() void {
  if (px == 0) {
    merge_row_topk();
    mpi_y.gather(0, @ptrcast([*]u32, &row_top_distances),
                 @ptrcast([*]u32, &all_distances), K, gather_col_i_task_id);
  } else {
    // Non-column PEs do not participate in the y-collectives. Unblock here
    // instead of bouncing through two additional no-op callbacks.
    sys_mod.unblock_cmd_stream();
  }
}

task gather_col_indices() void {
  if (px == 0) {
    mpi_y.gather(0, @ptrcast([*]u32, &row_top_indices),
                 @ptrcast([*]u32, &all_indices), K, finish_task_id);
  }
}

task finish() void {
  if ((px == 0) and (py == 0)) {
    merge_global_topk();
  }
  sys_mod.unblock_cmd_stream();
}

comptime {
  @export_symbol(ptr_D, "D");
  @export_symbol(ptr_D_norms, "D_norms");
  @export_symbol(ptr_q, "q");
  @export_symbol(ptr_valid_count, "valid_count");
  @export_symbol(ptr_final_distances, "distances");
  @export_symbol(ptr_final_indices, "indices");
  @export_symbol(main);
  @bind_local_task(bcast_q_down, bcast_q_down_task_id);
  @bind_local_task(compute, compute_task_id);
  @bind_local_task(gather_row_indices, gather_row_i_task_id);
  @bind_local_task(gather_col_distances, gather_col_d_task_id);
  @bind_local_task(gather_col_indices, gather_col_i_task_id);
  @bind_local_task(finish, finish_task_id);
}
