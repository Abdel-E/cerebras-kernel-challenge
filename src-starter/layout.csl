// Top-level layout for the distributed Top-K kNN kernel.
//
// The grader supplies P, d_dim, rows_per_pe, and K. The layout instantiates a
// P x P rectangle, assigns the same PE program to every tile, and passes both
// memcpy and collectives_2d parameters into that program. Host-visible symbols
// are exported here; PE-local storage and task bindings live in pe_program.csl.

param P: u16;
param d_dim: u16;
param rows_per_pe: u16;
param K: u16;
param D_block: u16;

const memcpy = @import_module("<memcpy/get_params>", .{
  .width = P,
  .height = P
});
const c2d = @import_module("<collectives_2d/params>");

layout {
  @set_rectangle(P, P);

  var x: u16 = 0;
  while (x < P) : (x += 1) {
    var y: u16 = 0;
    const memcpy_params = memcpy.get_params(x);
    while (y < P) : (y += 1) {
      const c2d_params = c2d.get_params(x, y, .{
        // Two x-colors and two y-colors are enough for the broadcast/gather
        // sequence used by pe_program.csl.
        .x_colors      = .{ @get_color(0),          @get_color(1) },
        .x_entrypoints = .{ @get_local_task_id(10), @get_local_task_id(11) },
        .y_colors      = .{ @get_color(4),          @get_color(5) },
        .y_entrypoints = .{ @get_local_task_id(12), @get_local_task_id(13) },
      });

      @set_tile_code(x, y, "pe_program.csl", .{
        .memcpy_params = memcpy_params,
        .c2d_params = c2d_params,
        .P = P,
        .d_dim = d_dim,
        .rows_per_pe = rows_per_pe,
        .K = K,
        .D_block = D_block
      });
    }
  }

  // Inputs are host-writable on every PE except q, which run.py writes only to
  // PE (0,0). distances/indices are read back from PE (0,0) after reduction.
  @export_name("D", [*]f32, true);
  @export_name("D_norms", [*]f32, true);
  @export_name("q", [*]f32, true);
  @export_name("valid_count", [*]u32, true);
  @export_name("distances", [*]f32, false);
  @export_name("indices", [*]u32, false);
  @export_name("main", fn()void);
}
