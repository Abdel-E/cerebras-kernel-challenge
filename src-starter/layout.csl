// Top-level layout entrypoint for the challenge submission.
//
// Required grader parameters:
//   P
//   d_dim
//   rows_per_pe
//   K
//
// Build this sequentially from known-working examples:
// - examples/tutorials/gemv-05-multiple-pes
//   - Start here for @set_rectangle(P, P), @set_tile_code, memcpy params,
//     and @export_name.
// - examples/tutorials/topic-11-collectives
//   - Use this when adding collectives_2d colors/entrypoints.
// - examples/benchmarks/gemv-collectives_2d
//   - Use this as the final P x P communication template.
//
// Step 1 scaffold:
// - Define params P, d_dim, rows_per_pe, K.
// - Import <memcpy/get_params> with width=P and height=P.
// - In layout, call @set_rectangle(P, P).
// - Loop over Px and Py and assign pe_program.csl to every tile.
// - Export only the simplest symbols needed for a smoke test:
//   - one input array
//   - one output array
//   - one main function
//
// Step 2 scaffold:
// - Add D, q, valid_count, indices, distances exports.
// - Verify host memcpy_h2d and memcpy_d2h before adding collectives.
//
// Step 3 scaffold:
// - Add collectives_2d params and an explicit task/color ID map.
// - Keep the ID map copied from the examples until we understand every ID.

param P: u16;
param d_dim: u16;
param rows_per_pe: u16;
param K: u16;

const memcpy = @import_module("<memcpy/get_params>", .{
  .width = P,
  .height = P
});
const c2d = @import_module("<collectives_2d/params>");

layout {
  @set_rectangle(P, P);

  var x: u16 = 0;
  while (x < P) : (x += 1) {
    var y: u16 = 0;
    const memcpy_params = memcpy.get_params(x);
    while (y < P) : (y += 1) {
      const c2d_params = c2d.get_params(x, y, .{
        .x_colors      = .{ @get_color(0),          @get_color(1) },
        .x_entrypoints = .{ @get_local_task_id(14), @get_local_task_id(15) },
        .y_colors      = .{ @get_color(4),          @get_color(5) },
        .y_entrypoints = .{ @get_local_task_id(16), @get_local_task_id(17) },
      });

      @set_tile_code(x, y, "pe_program.csl", .{
        .memcpy_params = memcpy_params,
        .c2d_params = c2d_params,
        .P = P,
        .d_dim = d_dim,
        .rows_per_pe = rows_per_pe,
        .K = K
      });
    }
  }

  // Final root output exports. Local candidates are gathered to PE (0,0).
  @export_name("D", [*]f32, true);
  @export_name("D_norms", [*]f32, true);
  @export_name("q", [*]f32, true);
  @export_name("valid_count", [*]u32, true);
  @export_name("distances", [*]f32, false);
  @export_name("indices", [*]u32, false);
  @export_name("main", fn()void);
}
